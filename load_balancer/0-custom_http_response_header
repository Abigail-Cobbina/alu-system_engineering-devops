#!/usr/bin/env bash
# This script installs nginx and adds an X-Served-By header containing the hostname
# shellcheck disable=SC2154
apt-get update -y
apt-get install -y nginx
echo "Holberton School" > /var/www/html/index.html
sed -i "s/server_name _;/server_name _;\n\tadd_header X-Served-By $(hostname);/" /etc/nginx/sites-enabled/default
service nginx restart
